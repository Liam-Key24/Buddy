# Buddy local/dev environment — never commit real keys.
# Copy to backend/.env and fill GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
BUDDY_AI_ENABLED=1
BUDDY_DB_PATH=
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8787
BUDDY_GROQ_TIMEOUT_S=45
BUDDY_GROQ_MAX_TOKENS=8192
# Comma-separated browser origins allowed to call the API.
# Same-origin production (UI served by FastAPI) usually needs none extra.
# BUDDY_CORS_ORIGINS=http://localhost:5173
# Optional: serve built UI from FastAPI (production single origin)
# BUDDY_STATIC_DIR=/opt/buddy/current/frontend/dist

# Enable Zero Data Retention in the Groq console for this API key.

# Private couple accounts (no public register). Required on first start.
BUDDY_USER_1=liam:change-me
BUDDY_USER_2=partner:change-me
BUDDY_MIGRATE_OWNER=liam
BUDDY_SESSION_SECRET=
# Set 1 in production behind Tailscale Serve HTTPS
BUDDY_COOKIE_SECURE=0
# Per-account Cloud AI requests per UTC day (shared key is 1000; split 500 each)
BUDDY_DAILY_REQUEST_LIMIT=500
