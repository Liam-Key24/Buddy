# Buddy local/dev environment — never commit real keys.
# Copy to backend/.env and fill GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
BUDDY_AI_ENABLED=1
BUDDY_DB_PATH=
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8787
BUDDY_GROQ_TIMEOUT_S=45
BUDDY_GROQ_MAX_TOKENS=8192
# Comma-separated browser origins allowed to call the API (required for Vercel).
# BUDDY_CORS_ORIGINS=http://localhost:5173,https://your-app.vercel.app

# Enable Zero Data Retention in the Groq console for this API key.
