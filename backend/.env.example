# Buddy local/dev environment — never commit real keys.
# Copy to backend/.env and fill GROQ_API_KEY.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
BUDDY_AI_ENABLED=1
BUDDY_DB_PATH=
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8787
BUDDY_GROQ_TIMEOUT_S=45
BUDDY_GROQ_MAX_TOKENS=1024

# Enable Zero Data Retention in the Groq console for this API key.
