[Unit]
Description=Buddy private FastAPI control plane
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=buddy
Group=buddy
WorkingDirectory=/opt/buddy/current/backend
EnvironmentFile=/etc/buddy/env
ExecStart=/opt/buddy/current/backend/.venv/bin/uvicorn app.main:app --host ${BUDDY_HOST} --port ${BUDDY_PORT} --workers 1 --proxy-headers
Restart=on-failure
RestartSec=3
# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/buddy
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
LockPersonality=true

[Install]
WantedBy=multi-user.target
