# Buddy production environment — copy to /etc/buddy/env (mode 0600).
# Never commit real values.

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
BUDDY_AI_ENABLED=1

# Production data outside the Git checkout
BUDDY_DB_PATH=/var/lib/buddy/buddy.db

# Bind localhost only — Tailscale Serve is the edge
BUDDY_HOST=127.0.0.1
BUDDY_PORT=8787

# Same-origin UI+API: CORS can stay minimal; add MagicDNS origin if needed
BUDDY_CORS_ORIGINS=

# Directory containing index.html from `frontend` production build
BUDDY_STATIC_DIR=/opt/buddy/current/frontend/dist

BUDDY_GROQ_TIMEOUT_S=45
BUDDY_GROQ_MAX_TOKENS=8192

# Private couple accounts — required on first start / schema v9 migrate
BUDDY_USER_1=liam:change-me
BUDDY_USER_2=partner:change-me
BUDDY_MIGRATE_OWNER=liam
BUDDY_SESSION_SECRET=
# Cookie Secure=1 behind Tailscale Serve HTTPS (same-origin /api)
BUDDY_COOKIE_SECURE=1
# Per-account Cloud AI requests per UTC day (shared Groq key is 1000)
BUDDY_DAILY_REQUEST_LIMIT=500

# Optional: refuse start if orphaned rows lack owner_user_id (after auth migration)
# BUDDY_REQUIRE_OWNERS=1
